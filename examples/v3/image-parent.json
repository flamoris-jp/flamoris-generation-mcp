    "cfg": {
      "type": "number",
      "schema_id": "image-cfg",
      "schema_revision": 1,
      "role": "cfg",
      "max_bytes": 64,
      "min_count": 0,
      "default": 7,
      "minimum": 0,
      "maximum": 100
